                ;F3/Pagina

pageKar:        db esc
                db 's'                  ;Setz Pagina stop
                db 'e'                  ;Entfern pagina stop
                db 'a'                  ;Entfern alle pagina stops
                db 'n'                  ;Pagina-nummer indicatie aan/uit
                db 'i'                  ;Pagina-stop indicatie aan/uit
                db 'g'                  ;Pagina-grens indicatie aan/uit
                db 0

                ;F3/Hulp

HLPKAR:         db ESC
                db 'z'                  ;Hulp naar text
                db 'v'                  ;Hulp naar menu
                db 0

                ;Printer instellingen

PRTKAR:         db ESC
                db 's'                  ;Setup string
                db 'o'                  ;Boven marge
                db 'u'                  ;Onder marge
                db 'l'                  ;pagina Lengte
                db '1'                  ;Kopregel tekst
                db '2'                  ;Voetregel tekst
                db 'm'                  ;Mail-Merge
                db 'n'                  ;Mail-Merge Naam
                db 'a'                  ;Kaart einde
                db 'd'                  ;Veld einde
                db 'e'                  ;Eerste paginanummer
                db 'p'                  ;Kopregel Positie
                db 't'                  ;Voetregel Positie
                db 'v'                  ;Formfeed
                db 'r'                  ;Continu printen
                db 'z'                  ;Kopregel marge
                db 'i'                  ;Voetregel marge
                db 'h'                  ;Mail-Merge teken
                db 'k'                  ;Eerste Kaart
                db 0

                ;Scherm instellingen

ScrKAR:         db ESC
                db 'b'                  ;Commandoregel op scherm
                db 'f'                  ;Kleuren cursor
                db 'c'                  ;Blok cursor
                db 'u'                  ;Voorloop nul
                db 's'                  ;Lichtkrant
                db 'h'                  ;Grote letters
                db 'm'                  ;MSX set
                db 'e'                  ;Edit mode
                db 'a'                  ;Auto-indent
                db 'r'                  ;Repeteer toetsen
                db 'z'                  ;Karakterset naam
                db 'i'                  ;Knipperende cursor aan/uit
                db 'n'                  ;Knippertijd aan
                db 'o'                  ;Knippertijd uit
                db 0

                ;Karaktertabel voor F4/Ga Naar

GOKAR:          db ESC                  ;Escape
                db 'z'                  ;Naar regel
                db 'a'                  ;Naar top
                db 'e'                  ;Naar bodem
                db 'b'                  ;Naar blokstart
                db 's'                  ;Naar blokeinde
                db 0

                ;F2/Alinea instellingen

aliKar:         db esc                  ;ESCape
                db 'b'                  ;Uitvullen
                db 'w'                  ;Afbreken
                db 'e'                  ;Inspringen
                db 't'                  ;Streepje
                db 0

                ;F5/Indent

indKar:         db esc                  ;ESCape
                db 'v'                  ;Aantal posities
                db left                 ;Schuif naar links
                db right                ;Schuif naar rechts
                db 0

                ;Videoram adressen van scherm teksten/waardes

VRMREG          equ 17                  ;Regelnummer
VRMKOL          equ 30                  ;Kolomnummer
VRMPAG          equ 40                  ;Paginanummer
VRMTF7          equ 45                  ;'F7:Hilfe'

                ;Cursor posities van schermteksten /waardes

XYFNK           equ 3101H               ;F2/X etc
XZOEK           equ 14                  ;Zoektekst

