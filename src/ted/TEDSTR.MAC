                ;Bestand: TEDSTR.MAC

if1
                .printx * Assemble: TEDSTR.MAC *
endif

                ;Dit bestand bevat alle TED-schermteksten en taal-afhankelijke
                ; karaktertabellen.

                ;De volgende talen worden ondersteund:
                ;
                ;TAAL EQU NL            ;Nederlands
                ;TAAL EQU DUITS         ; en Duits


tab             equ   9
lf              equ  10
cr              equ  13
esc             equ 1BH
right           equ 1CH
left            equ 1DH
up              equ 1EH
down            equ 1FH
nul             equ 255

                include offset.mac     ;Bevat var-offsets, Taal- en Demovlaggen

                global f2Kar,f3Kar,f4Kar,f5Kar,inhKar,prtKar,scrKar,indKar
                global goKar,aliKar,insKar,kolKar,hlpKar,memKar,tabKar,pageKar
                global tIntro,tGetName,tGetCode,tGebr
                global krtStart,krtEnd,tNoKrt,tF7
                global tStatus,tHulp0,tHulp2,tHulp3,tHulp4,tHulp5
                global tAan,tUit,tRegNr,tSelectie
                global tPad,tInh,tVrij,tVolume
                global tSaven,tTabCh,tabChr,tDirChr,tVldErr,tNoPb,tNextPg,tDruk
                global tMoment,tMeer,tZeker,tMemMap,tKeuze,tAlinea,tSort
                global TKOLOM,TKOLPOS,TGOTO,TKLEUR,TEXT,TBACKUP,TSCHERM,TDRIVER
                global TGETDRV,TPRTINS,TPSTAT,TKAART,TPBEGON,TMEM,TAFBR,TWIS
                global TCPHULP,TTOETS,TACCESS,tPage
                global TRECERR,TREGLEN,TONDERB,TMEMVOL,TTOMANY,TDISKVOL,TPROT
                global TNODISK,TDSKERR,TVERERR,TKARERR,TNOTFND,TPROB,TVERVANG
                global TSAVNAM,TLOADNAM,TSAVINS,TZOEK,TZOEK2,TWEL,TACHTER,TONV
                global tPageTabFull,tStkErr,tIndent,tRechts,tLinks

                ;Videoram adressen van scherm teksten/waardes

                global vrmReg,vrmKol,vrmPag,vrmTF7
                global xyFnk,xZoek
                global xUitvul,xAfbreek,xStreep,xInspr,xTabIns
                global xAantPos


                ;Karaktertabellen voor de funktietoetsen
                ; Indeling: Kar, kar, ..., 0


if              TAAL eq NL              ;TRUE indien TAAL=Nederlands

                ;Nederlandstalige karakters bij funktietoetsen

                ;Funktietoets 2

F2KAR:          db 'l'                  ;Linkerkantlijn
                db 'r'                  ;Rechterkantlijn
                db 'a'                  ;Alinea instellingen
                db 'z'                  ;Zet tab
                db 'w'                  ;Wis tab
                db 't'                  ;Tab instellingen
                db 'm'                  ;Change Memorymapper
                db 'p'                  ;Printer instelling
                db 's'                  ;Sorteer instelling
                db 'd'                  ;Printerdriver
                db 'b'                  ;Bewaar instellingen
                db 255                  ;Funktietoets
                db 0                    ;Einde van tabel

                ;Funktietoets 3

f3Kar:          db 'g'                  ;Geheugen vrij
                db 'w'                  ;wis Tekst/Buffer
                db 'i'                  ;disk Inhoud
                db 'b'                  ;Backup aan/uit
                db 'p'                  ;Pagina indikatie aan/uit/stop
                db 'k'                  ;Kleur instellen
                db 'e'                  ;Verander '.TXT'
                db 'l'                  ;Kolominstellen
                db 's'                  ;Scherm
                db 'h'                  ;Kopi‰er hulpmenu
                db 255                  ;Funktietoets
                db 0

                ;Funktietoets 4

F4KAR:          db 'n'                  ;Zoek nog eens
                db 'z'                  ;Zoek
                db 'b'                  ;Bewaar
                db 'l'                  ;Laad
                db 'g'                  ;Ga naar regel
                db 'p'                  ;Print de tekst
                db 's'                  ;Stop
                db 255                  ;Funktietoets
                db 0

                ;Funktietoets 5

f5Kar:          db 's'                  ;Startblok
                db 'e'                  ;Eindeblok
                db 'd'                  ;Wis blokdefinitie
                db 'k'                  ;Kopieer blok
                db 'w'                  ;Wis blok
                db 'v'                  ;Verplaats blok
                db 'p'                  ;Print blok
                db 't'                  ;sorTeer
                db 'l'                  ;Laad blok
                db 'b'                  ;Bewaar blok
                db 'i'                  ;Inspringen
                db 255                  ;Funktietoets
                db 0

                ;F2/Tab

tabKar:         db ESC
                db 'g'                  ;Gebruik in geheugen
                db 'b'                  ;Bewaren op disk
                db 'l'                  ;Direkt laden van disk
                db 0

                ;F2/MemMap

memKar:         db ESC
                db 'm'                  ;Mapper aan/uit
                db 'v'                  ;Vram aan/uit
                db 0

                ;F2/Bewaar instel.

insKar:         db ESC
                db 'e'                  ;Elke tekst bewaren
                db 't'                  ;Bewaar in TED
                db 'b'                  ;Bewaar instellingen
                db 'l'                  ;Laad instellingen
                db 0

                ;F3/Kolom

kolKar:         db ESC
                db 'a'                  ;Aantal kolommen
                db 0

                ;F3/Disk Inhoud

inhKar:         db ESC
                db DOWN
                db UP
                db RIGHT
                db LEFT
                db 'i'                  ;Inhoud
                db 'l'                  ;Tekst laden
                db 'b'                  ;Voeg een blok toe
                db 'w'                  ;File wissen
                db 'm'                  ;Mail-merge
                db 'k'                  ;Karakerset
                db 's'                  ;Instellingen
                db 0

                ;F3/Pagina

pageKar:        db esc
                db 'p'                  ;Plaats pagina stop
                db 'v'                  ;Verwijder paginastop
                db 'a'                  ;Verwijder alle paginastops
                db 'n'                  ;Pagina-nummer indicatie
                db 's'                  ;Pagina-stop indicatie
                db 'g'                  ;Pagina-grens indicatie
                db 0

                ;F3/Hulp

hlpKar:         db ESC
                db 't'                  ;Hulp naar text
                db 'm'                  ;Hulp naar menu
                db 0

                ;F2/Printer instellingen

PRTKAR:         db ESC
                db 's'                  ;Setup string
                db 'b'                  ;Boven marge
                db 'o'                  ;Onder marge
                db 'l'                  ;pagina Lengte
                db '1'                  ;Kopregel tekst
                db '2'                  ;Voetregel tekst
                db 'm'                  ;Mail-Merge
                db 'n'                  ;Mail-Merge Naam
                db 'a'                  ;Kaart einde
                db 'v'                  ;Veld einde
                db 'e'                  ;Eerste paginanummer
                db 'p'                  ;Kopregel Positie
                db 't'                  ;Voetregel Positie
                db 'f'                  ;Formfeed
                db 'c'                  ;Continu printen
                db 'r'                  ;Kopregel marge
                db 'g'                  ;Voetregel marge
                db 'i'                  ;Mail-Merge teken
                db 'k'                  ;Eerste Kaart
                db 0

                ;Scherm instellingen

scrKar:         db ESC
                db 's'                  ;Commandoregel op scherm
                db 'c'                  ;Kleuren cursor
                db 'b'                  ;Blok cursor
                db 'v'                  ;Voorloop nul
                db 'l'                  ;Lichtkrant
                db 'g'                  ;Grote letters
                db 'm'                  ;MSX set
                db 'e'                  ;Edit mode
                db 'a'                  ;Auto-indent
                db 'r'                  ;Repeteer toetsen
                db 'k'                  ;Karakterset naam
                db 'i'                  ;Knipperende cursor
                db 'n'                  ;Knippertijd aan
                db 'u'                  ;Knippertijd uit
                db 0

                ;Karaktertabel voor F4/Ga Naar

goKar:          db ESC                  ;Escape
                db 'r'                  ;Naar regel
                db 't'                  ;Naar top
                db 'b'                  ;Naar bodem
                db 's'                  ;Naar blokstart
                db 'e'                  ;Naar blokeinde
                db 0

                ;F2/Alinea instellingen

ALIKAR:         db ESC                  ;ESCape
                db 'u'                  ;Uitvullen
                db 'a'                  ;Afbreken
                db 'i'                  ;Inspringen
                db 's'                  ;Streepje
                db 0

                ;F5/Indent

indKar:         db esc                  ;ESCape
                db 'a'                  ;Aantal posities
                db left                 ;Schuif naar links
                db right                ;Schuif naar rechts
                db 0

                ;Videoram adressen van scherm teksten/waardes

VRMREG          equ 18                  ;Regelnummer
VRMKOL          equ 30                  ;Kolomnummer
VRMPAG          equ 41                  ;Paginanummer
VRMTF7          equ 46                  ;'F7:Hulp'

                ;Cursor posities van schermteksten /waardes

XYFNK           equ 3101H               ;F2/X etc
XZOEK           equ 15                  ;Zoektekst

                ;Schermteksten

if              DEMO

TINTRO:         db cr
                db 9,9,9,'  MSX2 Tekstverwerker - Editor',cr,lf
                db 9,9,9,9,'door M.J. Vriend',cr,lf
                db 9,9,9,9,'(c) 1992 Jos-Tel',cr,lf
                db 9,9,'   Demonstratieversie - kopi',89H,'ren toegestaan',cr,lf,lf,nul
TGETNAME:
TGETCODE:
TACCESS:
TGEBR:
else
TINTRO:         db cr
                db 9,9,9,'  MSX2 Tekstverwerker - Editor',cr,lf
                db 9,9,9,9,'door M.J. Vriend',cr,lf
                db 9,9,9,9,'(c) 1992 Jos-Tel',cr,lf
                db 9,9,9,'   Kopi',89H,'ren  NIET  toegestaan',cr,lf,lf,nul

TGETNAME:       db tab,tab,'Vraag uw code aan bij Jos-Tel!!',cr,lf,lf
                db tab,tab,'Gebruikers naam: ',nul
TGETCODE:       db cr,lf,tab,tab,'Gebruikers code: ',nul
TACCESS:        db cr,lf,tab,tab,'  Toegangs code: ',nul
TGEBR:          db cr,lf,tab,'Gebruiker: ',nul
endif

                ;Lichtkrant

KRTSTART:       db "              M.J. Vriend's TED "

if              DEMO
                db 'demonstratie'
endif
                db 'versie #2.65 (17 november 1992) '
                db 'copyright (C) 1992 Jos-Tel Aktie M.S. '
                db 'De opbrengst van TED komt ten goede '
                db 'aan de Nederlandse Multiple Sclerose Stichting. '
if              DEMO
                db 'Bestel de nieuwe TED #2.65 bij Jos-Tel. '
endif
                db 'Bel voor meer informatie naar de Jos-Tel databank 05149-1837, '
                db '24 per dag online. Of schrijf naar Jos de Boer, Kampenspaed 4, 8721 GL  WARNS.'
KRTEND:         db '                '
TNOKRT:         db "MJV's TED v#2.6]"
TF7:            db 'F7:Hulp '

TSTATUS:        db 'Invoeg:AAN  Regel:      Kolom:    Pagina:     '
                db "F7:Hulp [MJV's TED v#2.6]  0.00:00"
THULP0:         db ' F1/6=Omlaag/-hoog  F2=Instellingen  F3='
                db "Systeem  F4=Commando's  F5=Blokfunkties "
THULP2:         db ' Linker/Rechterkl. Alinea Zet/Wis-Tab Me'
                db 'mmap Printer-Driver Sort Bewaar  ESCape '
THULP3:         db ' Geheugen Wis Inhoud koLom Pagina Kleur '
                db 'Backup Extensie Scherm Hulp      ESCape '
THULP4:         db ' Nog_eens-Zoeken  Ga_naar  Print  Bewaar'
                db '/Laad_tekst  0..9-markeer  Stop  ESCape '
THULP5:         db ' Start Einde Wis_Def. Kopi',89H,'er Verplaats '
                db 'Print sorTeer Inspr. Laad Bewaar ESCape '

TAAN:           db 'AAN',nul
TUIT:           db 'UIT',nul
TREGNR:         db tab,tab,tab,'Naar regelnummer: ',nul
TLINKS:         db tab,tab,tab,'Linkerkantlijn: ',nul
TRECHTS:        db tab,tab,tab,'Rechterkantlijn: ',nul
